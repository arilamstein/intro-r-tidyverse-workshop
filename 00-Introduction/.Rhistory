ggplot(mpg) + geom_point(aes(x = displ, y = hwy, color = c("blah blah blah", "uno", "dos", "tres")))
ggplot(mpg) + geom_point(aes(x = displ, y = hwy, color = c("uno", "dos")))
ggplot(mpg) + geom_point(aes(x = displ, y = hwy, color = rep(c("uno", "dos"), 117))
ggplot(mpg) + geom_point(aes(x = displ, y = hwy, color = rep(c("uno", "dos"), 117)))
