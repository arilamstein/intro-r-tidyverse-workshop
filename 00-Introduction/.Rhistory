library(tidyverse)
mpg
ggplot(data=mpg) +
geom_point(mapping=aes(x=displ,y=hwy))
ggplot(data = mpg) +
geom_point(mapping = aes(x = displ, y = hwy, color=year, size=trans, shape=manufacturer))
